<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Web oturumu işleri dakikalarca sürebilir: WorkManager ön plan servisi (dataSync) + bildirim. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Masaüstü modu "Dosyalar" penceresi: cihazdaki dosyalara göz atmak ve kullanıcı bir AI penceresine bıraktığında o dosyayı
        web sayfasına vermek için. İzin yalnız kullanıcı onayıyla (Android ayarlarında) verilir; dosyalar hiçbir yere kendiliğinden gönderilmez.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        Launcher arama: kişi araması YALNIZ kullanıcı Launcher ayarlarında açıp izin verirse çalışır; rehber saklanmaz ve gönderilmez.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        Pil kısıtlamasını kaldırma iletişim kutusunu açmak için (Ayarlar > Pil). Kullanıcı onaylamadan hiçbir şey değişmez.
        Uzun süren arka plan üretimi için gereklidir; Xiaomi gibi cihazlar işi aksi hâlde sonlandırabilir.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Üreticiye özel güç/otomatik başlatma ekranlarını açabilmek için (paket görünürlüğü, Android 11+). -->
    <queries>
        <!-- Masaüstü modu uygulama başlatıcısı: cihazda kurulu ve başlatıcıda görünen uygulamalar. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Launcher: widget sağlayıcıları. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Dosyalar penceresi "Aç": dosyayı açabilen uygulamaları listelemek için. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Shizuku kurulu mu? (Ayarlar > Dosyalar: ayrıcalıklı erişim durumu) -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.asus.mobilemanager" />
    </queries>

    <application
        android:name=".KriptonCodApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.KriptonCod">
        <!-- ACRA'nın e-posta eki sağlayıcısı kullanılmıyor; kütüphane bildirimi "tools:replace" taşıdığı için burada aynı
             sağlayıcı bildirilir (üst bildirim yoksa birleştirici uyarı veriyordu). Dışa kapalıdır. -->
        <provider
            android:name="org.acra.attachment.AcraContentProvider"
            android:authorities="${applicationId}.acra"
            android:exported="false"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Başka uygulamadan "Paylaş > Kripton Code": metin launcher'ın "AI'a sor" sayfasında hazır açılır. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Ana ekran (launcher) olarak seçilebilsin: Android Ayarlar > Varsayılan uygulamalar > Ana ekran uygulaması.
            Bu girişle açılınca masaüstü modu zorla açılır; Ana Sayfa tuşu buraya döner.
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/desktop_home_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            Launcher bildirim paneli: yalnız kullanıcı Android ayarlarından "Bildirim erişimi"ni verirse çalışır.
            Bildirimler bellekte tutulur, diske yazılmaz ve ağa gönderilmez.
        -->
        <service
            android:name=".launcher.notify.KriptonNotificationListener"
            android:exported="true"
            android:label="@string/l_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Dosyayı başka uygulamada açmak için salt okuma URI'si (yalnız kullanıcı "Aç" dediğinde, seçilen uygulamaya). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Shizuku binder alıcısı. Yalnızca Shizuku çalışıyorsa ve kullanıcı izin verirse bir şey olur;
            uygulama Ayarlar'da "Shizuku ile sistem dosyaları" açılmadıkça Shizuku'ya hiç bağlanmaz.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Bildirimdeki Duraklat / Devam et / İptal düğmeleri (yalnız uygulamanın kendi PendingIntent'leri). -->
        <receiver
            android:name=".work.RunActionReceiver"
            android:exported="false" />

        <!-- Ana ekran widget'ı (Jetpack Glance): çalışan run'ı uygulamayı açmadan gösterir. -->
        <receiver
            android:name=".widget.RunWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/run_widget_info" />
        </receiver>

        <!--
            Google Identity Services — play-services-auth için zorunlu değil,
            ancak GoogleSignIn / AuthorizationClient kütüphanesi bu meta-data'yı kullanır.
            google-services.json eklenirse aşağıdaki satır otomatik üretilir; plugin olmadan
            manuel tutulabilir veya BuildConfig.GOOGLE_OAUTH_CLIENT_ID kullanılabilir.
        -->
    </application>
</manifest>
