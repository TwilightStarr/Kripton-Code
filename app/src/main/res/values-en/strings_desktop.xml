    <string name="desktop_perm_title">Desktop mode permissions</string>
    <string name="desktop_perm_body">Desktop mode runs full screen; system bars appear briefly when you swipe from the edge. The Files tab asks for all-files access; grant it now or the first time you open Files. The app launcher reads the names and icons of installed apps. Nothing leaves the device on its own.</string>
    <string name="desktop_perm_grant">Grant file access</string>
    <string name="desktop_perm_later">Not now</string>

    <string name="desktop_setting_title">Desktop mode (tablet)</string>
    <string name="desktop_setting_hint">Full screen, an app launcher with a bottom bar, and tabs. Apps open like tabs and you pin the ones you want to the bottom bar. Once enabled the app always starts in this mode; turn it off here or from the launcher.</string>
    <string name="desktop_setting_unavailable">This mode is for tablets (short screen side of at least 600 dp).</string>
    <string name="desktop_enable_title">Switch to desktop mode?</string>
    <string name="desktop_enable_body">The app turns into a full-screen desktop launcher: the apps you pin sit in a bottom bar, and apps (AI web interfaces, files, installed apps) open like tabs. Once enabled it starts in this mode every time; you can turn it off whenever you like.</string>
    <string name="desktop_enable_confirm">Switch to desktop</string>
    <string name="desktop_exit_title">Exit desktop mode?</string>
    <string name="desktop_exit_body">The app will start with the normal view next time. You can turn desktop mode back on from Settings or the side menu.</string>
    <string name="desktop_exit_confirm">Exit</string>
    <string name="desktop_home_label">Kripton Desktop</string>
    <string name="desktop_menu_set_home">Make home screen (launcher)</string>
    <string name="desktop_setting_home_hint">Use Kripton Desktop instead of the tablet’s home screen by making it the default home app. The Home button returns here; you can switch back in Android settings.</string>

