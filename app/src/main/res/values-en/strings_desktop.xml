    <!-- System files via Shizuku (Settings + Desktop > Files) -->
    <string name="settings_shizuku">System files via Shizuku</string>
    <string name="settings_shizuku_hint">Lets the Files window in desktop mode browse normally restricted folders such as /data, read-only. Off by default.</string>
    <string name="settings_shizuku_policy">Read-only: nothing is deleted or modified. No file is sent on its own; a file is only given to an AI tab\u2019s page when you drop it there. Turning this off releases the Shizuku connection.</string>
    <string name="shizuku_status_not_installed">Shizuku is not installed. Until then Files works with normal storage access.</string>
    <string name="shizuku_status_not_running">Shizuku is installed but not running. Open the Shizuku app and start it (wireless debugging or root).</string>
    <string name="shizuku_status_needs_permission">Shizuku is running. You need to grant this app access.</string>
    <string name="shizuku_status_ready_root">Ready \u2014 root mode: all system files including /data/data are readable.</string>
    <string name="shizuku_status_ready_adb">Ready \u2014 adb mode: Android/data and /data/local/tmp are readable; other apps\u2019 /data/data needs Shizuku started with root.</string>
    <string name="shizuku_status_ready_other">Ready. Access level depends on the user Shizuku runs as.</string>
