{
  "name": "CSS",
  "scopeName": "source.css",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#atrule"
    },
    {
      "include": "#block"
    },
    {
      "include": "#string"
    },
    {
      "include": "#selector"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.css",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.css",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.css",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.css",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.css",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "atrule": {
      "name": "keyword.control.at-rule.css",
      "match": "@[\\w-]+"
    },
    "selector": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.class.css",
          "match": "\\.[\\w-]+"
        },
        {
          "name": "entity.other.attribute-name.id.css",
          "match": "#[\\w-]+"
        },
        {
          "name": "entity.other.attribute-name.pseudo-class.css",
          "match": "::?[\\w-]+(?:\\([^)]*\\))?"
        },
        {
          "name": "entity.name.tag.css",
          "match": "\\b[a-zA-Z][\\w-]*\\b"
        },
        {
          "name": "keyword.operator.css",
          "match": "[>+~*]"
        }
      ]
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#block"
        },
        {
          "include": "#string"
        },
        {
          "include": "#atrule"
        },
        {
          "name": "support.type.property-name.css",
          "match": "(?<![\\w-])-{0,2}[a-zA-Z][\\w-]*(?=\\s*:)"
        },
        {
          "name": "keyword.other.important.css",
          "match": "!\\s*important"
        },
        {
          "name": "constant.other.color.css",
          "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\\b"
        },
        {
          "name": "constant.numeric.css",
          "match": "(?<![\\w#-])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|ex|ch|%|vh|vw|vmin|vmax|cm|mm|in|pt|pc|s|ms|deg|rad|turn|fr)?\\b"
        },
        {
          "name": "support.function.css",
          "match": "[a-zA-Z-]+(?=\\()"
        },
        {
          "name": "variable.other.css",
          "match": "--[\\w-]+|var\\(--[\\w-]+\\)"
        },
        {
          "name": "support.constant.property-value.css",
          "match": "\\b[a-zA-Z][\\w-]*\\b"
        }
      ]
    }
  }
}