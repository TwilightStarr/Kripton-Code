root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = off
# Composable fonksiyonlar PascalCase olur.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Mevcut kod tabanıyla uyum: bu kurallar ilk aşamada kapalı (taban çizgisi sonrası tek tek açılabilir).
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_import-ordering = disabled
ktlint_standard_filename = disabled
ktlint_standard_property-naming = disabled
# Kod tabanı sondaki virgülle yazılmış: izin ver.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Biçimlendirme kuralları: kod tabanı bunlara uymuyor; ktlint -F ile düzeltildikten sonra tek tek açın.
ktlint_standard_statement-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_chain-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_no-empty-first-line-in-method-block = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled

[*.{yml,yaml,xml}]
indent_size = 2
